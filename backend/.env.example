# Строка подключения из Supabase: кнопка "Connect" -> "Session pooler" (URI). [YOUR-PASSWORD] заменить на пароль базы
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
PORT=5000
FRONTEND_URL=http://localhost:3000
# Секрет для подписи JWT. В продакшене — свой длинный случайный, никому не показывать
JWT_SECRET=change-me-to-a-long-random-string
# Google OAuth: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
